# Web-Check environment configuration
# Copy this file to web-check.env and customize as needed.
# Keep API keys private; do not commit a populated environment file to Git.

# Web interface
WEB_CHECK_PORT=3000

# Optional third-party API credentials
GOOGLE_CLOUD_API_KEY=
SHODAN_API_KEY=
WHO_API_KEY=
SECURITY_TRAILS_API_KEY=
URL_SCAN_API_KEY=
CLOUDMERSIVE_API_KEY=
TRANCO_USERNAME=
TRANCO_API_KEY=
TORRENT_IP_API_KEY=
BUILT_WITH_API_KEY=

# API settings
API_ENABLE_RATE_LIMIT=true
PUBLIC_API_TIMEOUT_LIMIT=25000
API_CORS_ORIGIN=
TRUST_PROXY=

# Optional check selection and host restrictions
# Use values supported by the Web-Check version you deploy.
API_DISABLED_CHECKS=
API_ENABLED_CHECKS=
API_BLOCKED_HOSTS=
