<Container version="2">
  <Name>Sablier</Name>
  <Repository>sablierapp/sablier:1.15.0</Repository>
  <Registry>https://hub.docker.com/r/sablierapp/sablier</Registry>

  <!-- Default network for integration with Traefik.
       Users can change this to their reverse proxy Docker network. -->
  <Network>traefik</Network>

  <Shell>sh</Shell>
  <Privileged>false</Privileged>

  <!-- Startup command -->
  <Command>start --provider.name=docker</Command>

  <!-- Sablier icon -->
  <Icon>https://raw.githubusercontent.com/MikaPST/unraid-community-apps/main/icon-sablier.png</Icon>

<Overview>
    Sablier is a lightweight Docker-aware middleware that automatically starts and stops containers based on incoming requests. It integrates with reverse proxies such as Traefik and helps reduce resource consumption by stopping unused applications.
</Overview>

  <Project>https://github.com/sablierapp/sablier</Project>

  <TemplateURL>https://raw.githubusercontent.com/MikaPST/unraid-community-apps/main/templates/sablier.xml</TemplateURL>

  <ReadMe>https://github.com/MikaPST/unraid-community-apps/blob/main/README.md</ReadMe>

  <Category>Tools:Utilities</Category>

  <ExtraSearchTerms>
    Sablier Docker Traefik middleware container sleep wake
  </ExtraSearchTerms>

  <Requires>
    Docker socket access and a reverse proxy such as Traefik
  </Requires>

  <Changes>
    Initial release - Sablier 1.15.0
  </Changes>

  <Date>2026-09-16</Date>

  <MinVer>6.1</MinVer>

  <License>Apache-2.0</License>


  <!-- ========================= -->
  <!-- DOCKER SOCKET              -->
  <!-- ========================= -->

  <Config
    Name="Docker Socket"
    Target="/var/run/docker.sock"
    Default="/var/run/docker.sock"
    Mode="rw"
    Description="Docker socket used by Sablier to monitor and control Docker containers."
    Type="Path"
    Display="advanced"
    Required="true"
    Mask="false"
  />


  <!-- ========================= -->
  <!-- SABLIER CONFIGURATION      -->
  <!-- ========================= -->

  <Config
    Name="Sablier Configuration"
    Target="/etc/sablier/sablier.yml"
    Default="/mnt/user/appdata/sablier/sablier.yml"
    Mode="rw"
    Description="Path to the Sablier configuration file."
    Type="Path"
    Display="always"
    Required="true"
    Mask="false"
  />


  <!-- ========================= -->
  <!-- SABLIER THEMES             -->
  <!-- ========================= -->

  <Config
    Name="Themes"
    Target="/etc/sablier/themes"
    Default="/mnt/user/appdata/sablier/themes"
    Mode="rw"
    Description="Directory containing Sablier themes."
    Type="Path"
    Display="advanced"
    Required="false"
    Mask="false"
  />


  <!-- ========================= -->
  <!-- SABLIER HTTP PORT          -->
  <!-- ========================= -->

  <Config
    Name="HTTP Port"
    Target="10000"
    Default="10000"
    Mode="tcp"
    Description="Sablier HTTP API port."
    Type="Port"
    Display="always"
    Required="true"
    Mask="false"
  />


  <!-- ========================= -->
  <!-- TRAEFIK                    -->
  <!-- ========================= -->

  <Config
    Name="Traefik Enabled"
    Target="traefik.enable"
    Default="true"
    Description="Enable Traefik integration for Sablier."
    Type="Label"
    Display="advanced"
    Required="true"
    Mask="false"
  />

  <Config
    Name="Traefik Service Port"
    Target="traefik.http.services.sablier.loadbalancer.server.port"
    Default="10000"
    Description="Internal Sablier HTTP port used by Traefik."
    Type="Label"
    Display="advanced"
    Required="true"
    Mask="false"
  />

</Container>
